<?xml version="1.0"?>
<sdf version="1.9">
  <model name="convoy_robot_7">
    <!-- SIM-3 convoy robot carrying aruco id=7 (20cm). Generated by sim/gen_markers.py. -->
    <link name="base_link">
      <pose>0 0 0.1300 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.08</ixx><iyy>0.12</iyy><izz>0.15</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_col">
        <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
        <material><diffuse>0.15 0.15 0.18 1</diffuse></material>
      </visual>
      <visual name="marker_top">
        <pose>0 0 0.1255 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.2000 0.2000</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://convoy_robot_7/materials/textures/marker.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/convoy_robot_7/cmd_vel</topic>
      <!-- hold still (no gravity fall) until the rclpy driver sends cmd_vel;
           linear is body-frame, so constant linear.x + angular.z => a circle. -->
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
  </model>
</sdf>

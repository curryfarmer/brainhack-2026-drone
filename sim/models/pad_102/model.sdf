<?xml version="1.0"?>
<sdf version="1.9">
  <model name="pad_102">
    <!-- NAV-9 aruco id=102, 40cm static plane (3rd landing pad, for the 3-drone
         L2 gate). Same recipe as pad_100/pad_101. The texture
         materials/textures/pad_102.png is generated by sim/gen_markers.py
         (--type aruco --kind plane --prefix pad --ids 102 --size-cm 40), which
         sim/run_landing.sh runs at setup so the PNG exists on the VM. -->
    <static>true</static>
    <link name="link">
      <pose>0 0 0.001 0 0 0</pose>
      <visual name="marker_visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>0.4000 0.4000</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://pad_102/materials/textures/pad_102.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>

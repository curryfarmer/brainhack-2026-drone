<?xml version="1.0"?>
<!-- SIM-4 empty-world drill: a bare ground plane + ONE downward mono_cam_640 at
     1.7 m, NO markers. Feeds the "empty-world -> zero sightings, clean exit"
     control (perception must not hallucinate ArUco ids from a rendered but
     markerless scene). Run under llvmpipe (ogre2 is blank on the VM):
       LIBGL_ALWAYS_SOFTWARE=1 DISPLAY=:0 \
         GZ_SIM_RESOURCE_PATH=<repo>/sim/models gz sim -s -r sim/worlds/empty_cam.sdf
     Camera topic: /world/empty_cam/model/cam_down/link/camera_link/sensor/camera/image -->
<sdf version="1.9">
  <world name="empty_cam">
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.75 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.2 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- one downward camera over empty ground -->
    <include><uri>model://mono_cam_640</uri><name>cam_down</name><pose>0 0 1.7 0 1.5707 0</pose></include>
  </world>
</sdf>

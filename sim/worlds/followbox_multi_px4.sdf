<?xml version="1.0"?>
<!-- WS-4 SIM-B warm-up world, PX4-FLYABLE: takeoff -> navigate WEAVING past 3
     crates -> follow ONE convoy car driving an irregular path. The user's
     warm-up sim #2 ('more boxes / more complex environment').

     Forked from sim/worlds/followbox1_px4.sdf (same flight-sensor systems + ENU
     origin + onboard camera). What CHANGED: ONE crate becomes THREE, laid out as
     a slalom that forces the visibility-graph planner to weave (verified: an
     8-leg collision-free path to goal_ne_m [5.2,0], hugging crate_a's west edge
     then crate_c's south edge). The convoy car snakes between them via an
     irregular CONVOY_ROUTE (run_landing.sh followboxmulti).

     FRAME (binding — sitl_followbox_multi.json mirrors it): gz pose (x=E, y=N) is
     arena (north=y, east=x). Each crate's arena keep_out polygon mirrors its
     FOOTPRINT below — KEEP IN SYNC (WS-7B asserts it).
       crate_a gz(0.0, 1.8) -> north 1.3..2.3, east -0.5..0.5  (straddles east 0)
       crate_b gz(1.3, 3.3) -> north 2.8..3.8, east  0.8..1.8  (east lane)
       crate_c gz(-1.3,4.6) -> north 4.1..5.1, east -1.8..-0.8 (west lane, higher)
     All 1.0x1.0 x 3.0 m TALL (> the ~2.2 m track altitude -> genuine no-overfly).

     World NAME "followbox_multi_px4" -> /world/followbox_multi_px4/... topics. -->
<sdf version="1.9">
  <world name="followbox_multi_px4">

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"      name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"         name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-altimeter-system"         name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-magnetometer-system"      name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"            name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-forcetorque-system"       name="gz::sim::systems::ForceTorque"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.75 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.2 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- crate_a: gz (E=0.0, N=1.8). Straddles east 0 -> blocks the straight line. -->
    <model name="crate_a">
      <static>true</static>
      <pose>0.0 1.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.72 0.40 0.12 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- crate_b: gz (E=1.3, N=3.3). Blocks the east detour lane. -->
    <model name="crate_b">
      <static>true</static>
      <pose>1.3 3.3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.72 0.40 0.12 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- crate_c: gz (E=-1.3, N=4.6). Blocks the west lane higher up. -->
    <model name="crate_c">
      <static>true</static>
      <pose>-1.3 4.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.72 0.40 0.12 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- ONE convoy car PAST the slalom: convoy_robot_7 at gz(0, 5.6) = arena
         (north 5.6, east 0.0), just beyond goal_ne_m [5.2,0]. Yaw pi/2 = facing
         +Y (NORTH); the irregular CONVOY_ROUTE (run_landing.sh followboxmulti)
         snakes it. ArUco-7 marker on top is what track_convoy locks. -->
    <include>
      <uri>model://convoy_robot_7</uri><name>convoy_robot_7</name>
      <pose>0 5.6 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>

<?xml version="1.0"?>
<!-- S11 3-LANE convoy world (the "strong pipeline" demo): a fork of
     sim/worlds/convoy_px4.sdf with only 3 convoy robots, each at a DISTINCT
     spawn YAW so a constant forward Twist (angular.z = 0) drives them in 3
     DIVERGING straight lanes — one drone hovers over each lane and reads ONLY
     its car's unique ArUco id (clean 1-drone -> 1-car -> 1-id, unlike the
     SIM-5 circle where every drone sees every id).

     convoy_px4.sdf (the SIM-5 FULL-SIM world) is left UNTOUCHED so SIM-5 stays
     reproducible. Identical PX4 flight-sensor systems + GPS origin + render
     setup as convoy_px4 (ogre2 tag + LIBGL_ALWAYS_SOFTWARE=1 at launch =
     llvmpipe software GL, the proven combo; cam update_rate 5 lives in the
     x500_mono_cam_640 model, inherited).

     World NAME is "convoy_3lane" -> camera topics are /world/convoy_3lane/...;
     run via run_vision.sh lanes3 / track3 (PX4_GZ_WORLD=convoy_3lane). cmd_vel
     topics (/model/convoy_robot_<id>/cmd_vel) are model-scoped, so run_convoy.sh
     drives the robots regardless of world name.

     LANES (ENU x,y; spawns >= ~5 m apart so the nadir footprints never overlap):
       robot_7  spawn ( 3.0,  0.0) yaw 0       -> drives +x (East)
       robot_23 spawn (-1.5,  2.6) yaw 2.094   -> drives NW (120 deg)
       robot_88 spawn (-1.5, -2.6) yaw 4.189   -> drives SW (240 deg)
     Drone hover poses (one per lane, >= 1.2 m from its car spawn) live in
     run_vision.sh LANES3_POSES. -->
<sdf version="1.9">
  <world name="convoy_3lane">

    <!-- Camera render (SIM-3) + the flight-sensor systems PX4 needs (identical
         to convoy_px4.sdf — without Imu/AirPressure/Magnetometer/NavSat PX4
         preflight fails "sensor missing"). -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"      name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"         name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-altimeter-system"         name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-magnetometer-system"      name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"            name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-forcetorque-system"       name="gz::sim::systems::ForceTorque"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>

    <!-- GPS/NavSat origin (PX4 needs a global origin to fuse position). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.75 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.2 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- 3 convoy robots, 3 diverging lanes (see header). Distinct spawn yaws +
         a forward-only Twist (run_convoy.sh CONVOY_ANGULAR=0) = 3 straight lanes. -->
    <include><uri>model://convoy_robot_7</uri> <name>convoy_robot_7</name> <pose>3.0 0 0 0 0 0</pose></include>
    <include><uri>model://convoy_robot_23</uri><name>convoy_robot_23</name><pose>-1.5 2.6 0 0 0 2.094</pose></include>
    <include><uri>model://convoy_robot_88</uri><name>convoy_robot_88</name><pose>-1.5 -2.6 0 0 0 4.189</pose></include>

    <!-- 2 landing-pad markers, static (kept for parity with convoy_px4 / the
         land_on_pad future; clear of all 3 lanes). -->
    <include><uri>model://pad_100</uri><name>pad_100</name><pose>0.6 0.6 0 0 0 0</pose></include>
    <include><uri>model://pad_101</uri><name>pad_101</name><pose>-0.6 0.6 0 0 0 0</pose></include>

  </world>
</sdf>

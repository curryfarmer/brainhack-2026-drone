<?xml version="1.0"?>
<!-- SIM-3 convoy world (gz-only; NO PX4, NO flight, NO finals/ imports).

     5 marker-carrying robots orbit a 2 m circle that passes through the origin; a
     3-camera tower at the origin (1.2 / 1.7 / 2.2 m, looking straight down) sees every
     convoy marker at slant distance ~= camera altitude as it passes nadir -> a clean
     px-vs-distance table PER MARKER TYPE (check_detection.py). 2 landing-pad markers sit
     just north of the route, inside all three FOVs.

     Reskin ArUco<->QR by regenerating the model dirs (gen_markers.py --type ...); this
     world references type-AGNOSTIC model names, so it never changes.

     Run:
       export GZ_SIM_RESOURCE_PATH=<repo>/sim/models:$GZ_SIM_RESOURCE_PATH
       gz sim -s -r sim/worlds/convoy.sdf
     Convoy motion = rclpy driver (sim/convoy_driver.py) -> ros_gz bridge -> the
     /model/convoy_robot_<id>/cmd_vel topics the VelocityControl plugins subscribe. -->
<sdf version="1.9">
  <world name="convoy">

    <!-- Required systems. Without Sensors NO camera image topic is ever advertised;
         without Physics the VelocityControl convoy never integrates. -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.75 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.2 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- 5 convoy robots, phase-offset around the circle (center (0,-2), R=2, CCW).
         Poses computed by sim/gen_markers route math; robot 7 starts at the origin nadir. -->
    <include><uri>model://convoy_robot_7</uri> <name>convoy_robot_7</name> <pose>0 0 0 0 0 3.1416</pose></include>
    <include><uri>model://convoy_robot_11</uri><name>convoy_robot_11</name><pose>-1.902 -1.382 0 0 0 4.3982</pose></include>
    <include><uri>model://convoy_robot_23</uri><name>convoy_robot_23</name><pose>-1.176 -3.618 0 0 0 5.6549</pose></include>
    <include><uri>model://convoy_robot_42</uri><name>convoy_robot_42</name><pose>1.176 -3.618 0 0 0 0.6283</pose></include>
    <include><uri>model://convoy_robot_88</uri><name>convoy_robot_88</name><pose>1.902 -1.382 0 0 0 1.8850</pose></include>

    <!-- 2 landing-pad markers, static, just north of the route (inside all 3 FOVs). -->
    <include><uri>model://pad_100</uri><name>pad_100</name><pose>0.8 0.5 0 0 0 0</pose></include>
    <include><uri>model://pad_101</uri><name>pad_101</name><pose>-0.8 0.5 0 0 0 0</pose></include>

    <!-- Camera tower at the origin, looking straight down (pitch +pi/2). The convoy
         passes nadir at slant distance ~= each camera's altitude.
         3 SENTRY bands (1.2 / 1.7 / 2.2 m) = the drone search altitudes.
         1 DIAGNOSTIC band (0.7 m) added to bracket the QR decode floor: at sentry
         altitudes a <=40 cm QR is < 4 px/module and never decodes (the ArUco-vs-QR
         finding); 0.7 m is where a 40 cm pad QR clears ~4 px/module, proving the QR
         pipeline works and bounding the floor. NOT a sentry altitude. -->
    <include><uri>model://mono_cam_640</uri><name>cam_band_070</name><pose>0 0 0.7 0 1.5707 0</pose></include>
    <include><uri>model://mono_cam_640</uri><name>cam_band_120</name><pose>0 0 1.2 0 1.5707 0</pose></include>
    <include><uri>model://mono_cam_640</uri><name>cam_band_170</name><pose>0 0 1.7 0 1.5707 0</pose></include>
    <include><uri>model://mono_cam_640</uri><name>cam_band_220</name><pose>0 0 2.2 0 1.5707 0</pose></include>

  </world>
</sdf>
